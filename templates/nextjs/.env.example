# Server-side only — NEVER expose these with NEXT_PUBLIC_*
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_IS_PRODUCTION=false

# Public (safe to expose) — used by snap.js in the browser
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Keep both production flags in sync — mismatched flags are the #1 integration bug
